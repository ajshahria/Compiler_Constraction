=== Headers ===
Header              Line  Category      Role in this compiler
------------------------------------------------------------------------
<iostream>          2     I/O           enables cout / endl  - std::cout / std::cin streams
=== Three Address Code ===
    b = 3
    read a
    outs "Sum: "
    t1 = a + b
    out t1
    outnl
    t2 = a > b
    ifFalse t2 goto L1
    outs "greater\n"
    goto L2
L1:
    outs "not greater\n"
L2:
    i = 0
L3:
    t3 = i < 6
    ifFalse t3 goto L4
    t4 = i == 2
    ifFalse t4 goto L6
    goto L5
L6:
    t5 = i == 4
    ifFalse t5 goto L7
    goto L4
L7:
    out i
    outs " "
L5:
    t6 = i + 1
    i = t6
    goto L3
L4:
    outnl
    n = 5
    f = 1
L8:
    t7 = f * n
    f = t7
    t8 = n - 1
    n = t8
    t9 = n > 0
    ifFalse t9 goto L9
    goto L8
L9:
    outs "5! = "
    out f
    outnl
    t10 = a != 1
    ifFalse t10 goto L12
    t11 = a != 2
    ifFalse t11 goto L13
    t12 = a != 3
    ifFalse t12 goto L14
    goto L15
L12:
    outs "one"
    goto L11
L13:
L14:
    outs "two or three"
L15:
    outs " (fell through)"
L11:
    outnl
    t13 = a + b
    t14 = (float) t13
    t15 = t14 / 2.0
    avg = t15
    outs "avg "
    out avg
    outnl
    outs "ok? "
    t16 = avg > 2.0
    out t16
    outnl
    goto L16
L16:
