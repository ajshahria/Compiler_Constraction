=== Headers ===
Header              Line  Category      Role in this compiler
------------------------------------------------------------------------
<iostream>          1     I/O           enables cout / endl  - std::cout / std::cin streams
<cmath>             2     Math          accepted (no effect)  - sqrt, pow, sin, ...
=== Three Address Code ===
    N = 5
    total = 0.0
    i = 1
L1:
    t1 = i <= N
    ifFalse t1 goto L2
    t2 = (float) i
    t3 = 1.0 / t2
    t4 = total + t3
    total = t4
    t5 = i + 1
    i = t5
    goto L1
L2:
    outs "H5 = "
    out total
    outnl
    x = 17
    t6 = x % 2
    t7 = t6 == 0
    ifFalse t7 goto L4
    t8 = 0
    goto L5
L4:
    t8 = 1
L5:
    out t8
    outnl
    goto L6
L6:
=== Optimized TAC ===
    N = 5
    total = 0.0
    i = 1
L1:
    t1 = i <= N
    ifFalse t1 goto L2
    t2 = (float) i
    t3 = 1.0 / t2
    total = total + t3
    i = i + 1
    goto L1
L2:
    outs "H5 = "
    out total
    outnl
    x = 17
    out 1
    outnl
